{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "amadeus-builder-agent",
  "description": "AI-DLC Builder Agent — delegation target for swarm units, reviewed fixes, call-site migrations, test builds, and other scoped implementation work.",
  "prompt": "file://amadeus-builder-agent.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "thinking"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "bun \\.kiro/tools/.*",
        "date -u .*"
      ]
    }
  },
  "resources": [
    "file://.kiro/agents/amadeus-builder-agent.md",
    "file://.kiro/knowledge/amadeus-builder-agent/*.md",
    "file://.kiro/knowledge/amadeus-shared/*.md",
    "file://amadeus/spaces/default/memory/**/*.md"
  ],
  "hooks": {},
  "model": "claude-opus-4.8"
}
