{
  "$schema": "https://raw.githubusercontent.com/aws/amazon-q-developer-cli/refs/heads/main/schemas/agent-v1.json",
  "name": "amadeus-developer-agent",
  "description": "AI-DLC Developer Agent \u2014 delegation target for the named reverse-engineering (2.1) and code-generation (3.5) lifecycle stages.",
  "prompt": "file://amadeus-developer-agent.md",
  "tools": [
    "fs_read",
    "fs_write",
    "execute_bash",
    "thinking"
  ],
  "allowedTools": [
    "fs_read",
    "thinking"
  ],
  "toolsSettings": {
    "execute_bash": {
      "allowedCommands": [
        "bun \\.kiro/tools/.*",
        "date -u .*"
      ]
    }
  },
  "resources": [
    "file://.kiro/agents/amadeus-developer-agent.md",
    "file://.kiro/knowledge/amadeus-developer-agent/*.md",
    "file://.kiro/knowledge/amadeus-shared/*.md",
    "file://amadeus/spaces/default/memory/**/*.md"
  ],
  "hooks": {},
  "model": "claude-opus-4.8"
}
