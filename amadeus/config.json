{
  "intent-mirror": {
    "github": {
      "issue": {
        "consent": "auto"
      },
      "project": {
        "targets": [
          {
            "project": "amadeus-dlc/5"
          }
        ]
      }
    }
  },
  "finding": {
    "github": {
      "issue": {
        "creation": {
          "consent": "auto"
        }
      }
    }
  },
  "swarm": {
    "unit": {
      "concurrency": {
        "limit": 4
      }
    }
  },
  "plugin": {
    "activation": {
      "names": [
        "coverage-patch-quick",
        "git-drift",
        "github-pr-convergence"
      ]
    },
    "scope-bindings": {
      "github-pr-convergence": {
        "pr-convergence": [
          "self-document",
          "self-feature",
          "self-fix",
          "self-refactor"
        ]
      }
    }
  }
}
